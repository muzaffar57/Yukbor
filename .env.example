# Ma'lumotlar bazasi
DATABASE_URL=postgresql+asyncpg://logistics_user:logistics_pass_dev@localhost:5432/logistics_db

# Xavfsizlik (production'da albatta uzun va tasodifiy qiymat bilan almashtiring)
SECRET_KEY=CHANGE_THIS_SECRET_KEY_IN_PRODUCTION

# Telegram bot (https://t.me/BotFather orqali bot yaratib, tokenni shu yerga qo'ying)
# Kanal ID odatda "-100" bilan boshlanadi (botni kanalga admin qilib qo'shgandan keyin olinadi)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Faqat LOKAL sinov uchun (Telegram'siz WebApp'ni brauzerda tekshirish).
# Production'da (Railway) buni hech qachon true qilmang!
TELEGRAM_MOCK_AUTH_ENABLED=false
